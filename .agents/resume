#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command -v git >/dev/null
git rev-parse --is-inside-work-tree >/dev/null

sudo service postgresql start >/dev/null || true
pg_isready -q
printf 'Orb resume complete; PostgreSQL is ready.\n'
